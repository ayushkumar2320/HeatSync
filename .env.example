# =============================================================================
# Urban Digital Twin — Environment variables
# =============================================================================
# Copy to .env and fill in values.  All UDT_ prefixed variables are read by
# the backend via pydantic-settings.

# --- Application -----------------------------------------------------------
UDT_APP_NAME="Urban Digital Twin API"
UDT_VERSION="1.0.0"
UDT_DEBUG=false
UDT_LOG_LEVEL=INFO

# --- CORS ------------------------------------------------------------------
# Comma-separated origins; the Vite dev server is included by default.
UDT_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]'

# --- Database (optional PostGIS) -------------------------------------------
# UDT_DATABASE_URL=postgresql://admin:password@localhost:5432/urban_digital_twin

# --- Rate limiting ---------------------------------------------------------
UDT_RATE_LIMIT_ENABLED=true
UDT_RATE_LIMIT_AI_PER_MINUTE=20
UDT_RATE_LIMIT_SIM_PER_MINUTE=10

# --- Live data probes ------------------------------------------------------
# Set to false in CI/offline environments for fast deterministic health checks.
UDT_ENABLE_LIVE_PROBES=true
UDT_LIVE_PROBE_TIMEOUT_SECONDS=5.0
UDT_LIVE_WEATHER_CACHE_SECONDS=600
UDT_LIVE_AQI_CACHE_SECONDS=600

# --- AI / Nemotron ---------------------------------------------------------
# NEMOTRON_API_KEY=your_nvidia_nim_api_key_here

# --- Landsat Historical LST Pipeline --------------------------------------
UDT_LANDSAT_ENABLED=true
UDT_LANDSAT_MAX_CLOUD_COVER=30

# --- Frontend (VITE_ prefix — exposed to client-side) ----------------------
# VITE_BACKEND_API_URL="http://localhost:8000/api"
