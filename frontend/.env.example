# =============================================================================
# HeatSync Frontend Environment Configuration
# =============================================================================

VITE_APP_NAME="HeatSync - Hyperlocal Urban Digital Twin"
VITE_PILOT_ZONE="Khandagiri & ITER Campus, Bhubaneswar"

# Backend API Base URL
# In development, you can use http://127.0.0.1:8000/api or /api
VITE_BACKEND_API_URL="http://127.0.0.1:8000/api"

# Feature Flags
VITE_ENABLE_3D_ELEVATION=true
VITE_DEFAULT_THEME=dark

# Optional Third-Party API Keys (for live weather / audits)
# VITE_OPENWEATHER_API_KEY=
# VITE_OPENAQ_API_KEY=
# VITE_NASA_POWER_API_KEY=
# VITE_NASA_EARTHDATA_TOKEN=
# VITE_COPERNICUS_DATASPACE_KEY=
# VITE_MAPBOX_ACCESS_TOKEN=
# VITE_TOMTOM_TRAFFIC_API_KEY=
# VITE_HERE_TRAFFIC_API_KEY=
# VITE_DATA_GOV_IN_API_KEY=
# VITE_ISRO_BHUVAN_API_KEY=
# VITE_CESIUM_ACCESS_TOKEN=
